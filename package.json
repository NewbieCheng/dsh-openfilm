{
  "name": "dsh-openfilm",
  "version": "0.11.3",
  "description": "OpenFilm video studio as a DSH plugin: the official Studio + Chat shell, bridged to a DSH session.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "plugin",
    "openfilm",
    "video",
    "cordis"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "templates:build": "node scripts/templates-build.mjs",
    "templates:check": "node scripts/templates-build.mjs --check",
    "motion:index": "node scripts/build-motion-index.mjs",
    "login:city": "node scripts/build-login-city.mjs",
    "frame:page": "node scripts/render-page-frame.mjs",
    "frame:studio": "node scripts/studio-frame-check.mjs",
    "studio:ui": "node scripts/studio-ui-check.mjs",
    "onboard:preview": "node scripts/onboard-preview.mjs",
    "smoke:system": "node scripts/system-smoke.mjs",
    "dev:styles": "node scripts/dev-styles.mjs",
    "brand:check": "node scripts/brand-check.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "patches:split": "node scripts/split-patch.mjs",
    "patches:check": "node scripts/split-patch.mjs --check",
    "upstream:status": "node scripts/upstream.mjs status",
    "upstream:fetch": "node scripts/upstream.mjs fetch",
    "upstream:verify": "node scripts/upstream.mjs verify",
    "shell:dev": "node scripts/upstream.mjs shell:dev",
    "shell:bake": "node scripts/theme-bake.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  },
  "dependencies": {
    "openfilm": "https://registry.npmjs.org/openfilm/-/openfilm-0.3.2.tgz",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "sherpa-onnx-node": "2.0.1"
  },
  "engines": {
    "node": ">=22.2"
  },
  "bundledDependencies": [
    "openfilm",
    "zod"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./openfilm-prompt": "./src/openfilm-prompt.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "assets",
    "brand",
    "patches",
    "skills",
    "src",
    "vendor",
    "scripts",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "docs",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  }
}
