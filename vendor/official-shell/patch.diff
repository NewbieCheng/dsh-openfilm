+/** Sky + orb colours for a point in the day: morning dark, noon bright, warm afternoon, orange dusk, deep blue night. */
+function skyFor(v: number) {
+  const mix = (layers: [number, number, number, number][]) => {
+    let r = 0, g = 0, b = 0, a = 0;
+    for (const [lr, lg, lb, la0] of layers) {
+      const la = Math.round(la0 * 50) / 50;
+      if (la <= 0) continue;
+      r = lr * la + r * (1 - la);
+      g = lg * la + g * (1 - la);
+      b = lb * la + b * (1 - la);
+      a = la + a * (1 - la);
+    }
+    return `rgba(${Math.round(r)},${Math.round(g)},${Math.round(b)},${Math.round(a * 100) / 100})`;
+  };
+  const morning = 1 - smooth(0.04, 0.3, v);
+  const warm = smooth(0.45, 0.72, v) * (1 - smooth(0.82, 1, v));
+  const dusk = smooth(0.62, 0.86, v) * (1 - smooth(0.95, 1, v));
+  const night = smooth(0.8, 1, v);
+  const top = mix([[6, 18, 48, morning * 0.6], [255, 196, 120, warm * 0.22], [255, 104, 56, dusk * 0.55], [8, 12, 40, night * 0.78]]);
+  const bottom = mix([[10, 40, 90, morning * 0.6], [255, 150, 80, warm * 0.22], [38, 18, 58, dusk * 0.55], [3, 6, 20, night * 0.78]]);
+  return { sky: `linear-gradient(180deg,${top} 0%,${bottom} 100%)`, night };
