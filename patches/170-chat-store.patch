+/**
+ * Delete one conversation for good: its record, and every turn it still held.
+ *
+ * Turns are dropped here as well as on the Host: the Host prunes them when the
+ * saved list no longer names their session, and the page must not keep drawing a
+ * conversation nobody can reach any more.
+ */
+export function deleteChatSession(project: string, id: string) {
+  const chat = record(project);
+  chat.sessions = chat.sessions.filter((s) => s.id !== id);
+  chat.turns = chat.turns.filter((entry) => entry.turn.sessionId !== id);
+  if (chat.last === id) chat.last = null;
+  writeSessions(project);
+}
