+          ))}
+        </div>
+        <button type="button" className="lg-play" aria-label={playing ? '暂停' : '播放'} title={playing ? '暂停' : '播放'} onClick={() => setPlaying(v => !v)}>
+          <span style={{ display: 'contents' }} dangerouslySetInnerHTML={{ __html: playing ? PAUSE_ICON : PLAY_ICON }} />
+        </button>
+        <div
