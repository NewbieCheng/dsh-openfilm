+              <div key={name} ref={node => { if (node) clipRefs.current[i] = node; }} className="lg-clip" style={{ flex: String(DUR[i]) }}>{name}</div>
+            ))}
+          </div>
+          <div ref={playheadRef} className="lg-playhead">
+            <div className="lg-grip"><span ref={tipRef} className="lg-tip">09:00 上班</span></div>
+          </div>
+        </div>
+      </div>
+
+      <div className="lg-vig" aria-hidden="true" />
+
+      {captcha.open && (
+        <div className="cap-mask" role="presentation">
+          <div className="cap" role="dialog" aria-modal="true" aria-label="人机验证">
+            <h2>人机验证</h2>
+            <p className="hint">{captcha.hint}</p>
+            <div className="stage" onClick={onCaptchaClick} dangerouslySetInnerHTML={{ __html: captcha.error && !captcha.svg ? '<div style="display:grid;place-items:center;min-height:200px;color:#8d90a6">加载中…</div>' : captcha.svg }} />
+            {captcha.marks.map((mark, i) => (
+              <span key={i} style={{ position: 'absolute', left: mark.x, top: mark.y, width: 20, height: 20, margin: '-10px 0 0 -10px', borderRadius: '50%', background: '#FF6400', color: '#fff', display: 'grid', placeItems: 'center', font: '700 10px/1 inherit', pointerEvents: 'none', boxShadow: '0 0 0 2px #fff' }}>{mark.n}</span>
+            ))}
+            <p className="err">{captcha.error}</p>
+            <div className="acts">
+              <button type="button" className="refresh" onClick={() => void loadCaptcha()}>换一张</button>
+              <button type="button" className="cancel" onClick={closeCaptcha}>取消</button>
+            </div>
+          </div>
+        </div>
+      )}
+    </div>
+  );
