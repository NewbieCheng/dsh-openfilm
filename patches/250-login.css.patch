per),var(--paper-2));box-shadow:0 0 0 1px rgba(255,100,0,.28),0 24px 56px rgba(0,0,0,.5)}.nof-lg .tape{position:absolute;top:-9px;left:-12px;width:72px;height:20px;transform:rotate(-8deg);background:repeating-linear-gradient(135deg,rgba(255,255,255,.3) 0 4px,transparent 4px 9px),rgba(255,100,0,.88);z-index:2}.nof-lg h1{margin:0;font:400 28px/1.2 var(--hand);letter-spacing:.02em;color:var(--brand)}.nof-lg .sub{margin:6px 0 14px;font-size:12px;color:var(--ink-dim);line-height:1.45}.nof-lg .fld{display:block;margin-bottom:12px}.nof-lg .fld>span{display:block;font-size:12px;color:var(--ink-dim);margin-bottom:1px}.nof-lg .inw{position:relative;display:flex;align-items:center}.nof-lg .inw>.ic{position:absolute;left:2px;width:16px;height:16px;color:var(--ink-dim);flex:none;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.nof-lg .inw:focus-within>.ic{color:var(--orange)}.nof-lg .fld input{width:100%;font:500 15px var(--sans);color:var(--ink);background:transparent;border:0;border-bottom:1px solid rgba(24,23,28,.35);border-radius:0;padding:7px 30px 7px 26px;outline:0;caret-color:var(--orange)}.nof-lg .fld input:focus-visible{border-bottom-color:var(--orange);box-shadow:0 1px 0 var(--orange)}.nof-lg .fld input::placeholder{color:#a8a291}.nof-lg .eye{position:absolute;right:0;display:grid;place-items:center;width:28px;height:28px;color:var(--ink-dim);background:none;border:0;border-radius:50%;cursor:pointer;padding:0;font-size:14px}.nof-lg .go{width:100%;margin-top:6px;font:500 15px var(--sans);letter-spacing:.06em;padding:.72em 1em;border-radius:2px;border:0;background:var(--brand);color:#fff;cursor:pointer;box-shadow:inset 0 -2px 0 rgba(255,100,0,.85)}.nof-lg .go:disabled{opacity:.55;cursor:default}.nof-lg .links{display:flex;justify-content:space-between;gap:10px;margin-top:10px;font-size:12px;flex-wrap:wrap}.nof-lg .lk{color:var(--orange-deep);background:none;border:0;font:inherit;padding:2px 0;cursor:pointer;text-decoration:underl