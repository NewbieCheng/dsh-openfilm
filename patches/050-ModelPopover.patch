+/**
+ * The choices, split where their names group them.
+ *
+ * The Host names a model `<group> / <model>` (official-model-catalog.mjs), so a
+ * flat list repeats the group on every line and cuts the model name to fit. This
+ * turns that into what DSH's own menu shows: a heading per group, and each model
+ * named in full under it. A name with no separator is its own label.
+ */
+function groupChoices(choices: NonNullable<Option['options']>): Array<{
+  choice: NonNullable<Option['options']>[number]; group: string; label: string; heading: string | null;
+}> {
+  let last = '';
+  return choices.map((choice) => {
+    const at = choice.name.indexOf(' / ');
+    const group = at > 0 ? choice.name.slice(0, at) : '';
+    const label = at > 0 ? choice.name.slice(at + 3) : choice.name;
+    const heading = group && group !== last ? group : null;
+    if (heading) last = group;
+    return { choice, group, label, heading };
+  });
+}
