+/**
+ * dsh-openfilm: ![](url) drawn as a picture.
+ *
+ * The frame an agent renders is the thing the person is looking at, so it belongs in the conversation
+ * rather than behind a link. Clicking opens the same full-size preview attachments use.
+ */
+function InlinePicture({ src }: { src: string }) {
+  const t = useT();
+  const [open, setOpen] = React.useState(false);
+  const [failed, setFailed] = React.useState(false);
+  const name = src.split(/[\\/]/).pop() ?? src;
+  if (failed) {
+    return <span role="alert" className="break-all text-[12px] text-[var(--text-faint)]">{t('assets.previewFailed')} · {name}</span>;
+  }
+  return <>
+    <button type="button" onClick={() => setOpen(true)} className="my-1.5 block max-w-full text-left">
+      {/* eslint-disable-next-line @next/next/no-img-element */}
+      <img src={src} alt={name} draggable={false} loading="lazy" onError={() => setFailed(true)}
+        className="max-h-[420px] w-auto max-w-full rounded-[6px] border border-[var(--border)] object-contain" />
+    </button>
+    {open ? <AttachmentPreview item={{ name, kind: 'document', url: src }} onClose={() => setOpen(false)} /> : null}
+  </>;
+}
